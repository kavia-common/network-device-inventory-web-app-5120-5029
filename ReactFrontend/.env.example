# ReactFrontend environment variables

# PUBLIC_INTERFACE
# VITE_API_BASE_URL
# Base URL for the Flask backend API.
# If not set, the app will default to http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001

# Preferred ports for Vite dev server and preview (optional)
PORT=3000
VITE_PORT=3000

# If HMR client is accessed via a different public port, set it here (optional)
# VITE_HMR_CLIENT_PORT=3000
