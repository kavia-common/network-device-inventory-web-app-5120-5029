# FlaskBackendAPI environment variables

# PUBLIC_INTERFACE
# PORT
# Port to run the Flask server on (default 3001)
PORT=3001

# PUBLIC_INTERFACE
# CORS_ALLOW_ORIGINS
# Comma-separated list of allowed origins for CORS (frontend dev server URLs)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Optional metadata
APP_VERSION=dev

# MongoDB connection (placeholders for future use)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=network_inventory
MONGO_COLLECTION=devices
